POSTGRES_USER=bluestrix
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bluestrix
# Used by docker-compose (bluestrix-api, bluestrix-worker). Host 'postgres' is the compose service.
# Placeholder password: production rejects it (see docs/ai-gateway/installation.md).
DATABASE_URL=postgresql+psycopg://bluestrix:change-me@postgres:5432/bluestrix
REDIS_PASSWORD=change-me
BLUESTRIX_MODE=defensive
BLUESTRIX_EXECUTION=restricted
SANDBOX_NETWORK=none
SANDBOX_MEMORY_MB=512
SANDBOX_CPU=0.5

# AI router — never commit real keys
DEEPSEEK_API_KEY=change-me
DEEPSEEK_BASE_URL=https://model.inferx.net/endpoints/v1
DEEPSEEK_MODEL=deepseek-v4.1-flash-1017
OPENAI_API_KEY=change-me
ANTHROPIC_API_KEY=change-me
GROQ_API_KEY=change-me

# ---------------------------------------------------------------------------
# AI gateway: environment and secrets
# Copy this file for local development only. Never copy it to production as-is.
# Secrets below are placeholders. Set real values only in the deployment secret store.
# ---------------------------------------------------------------------------

# development | test | production. Unset or unknown = production rules (fail secure).
BLUESTRIX_ENV=development

# Server-side secrets (production requires strong, distinct values of 32+ characters).
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
BLUESTRIX_JWT_SECRET=change-me
BLUESTRIX_MFA_KEY=change-me
# Must NOT be set in production (ephemeral dev-only JWT secret).
# BLUESTRIX_DEV_JWT_SECRET=

# Non-secret gateway tuning.
BLUESTRIX_AI_TIMEOUT_SECONDS=30
BLUESTRIX_AI_MAX_RETRIES=1

# Customer provider credentials will move to the BYOK vault in a later phase.
# Until then, provider keys come from the environment only and are never logged.
