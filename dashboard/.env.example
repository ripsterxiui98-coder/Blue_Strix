# Public URL of the BlueStrix FastAPI (read-only default)
NEXT_PUBLIC_BLUESTRIX_API_URL=http://127.0.0.1:8787

# NextAuth — generate a random value locally; never commit real secrets
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-generate-a-long-random-string

# Demo auth only (local). Do not use in production.
DASHBOARD_DEMO_PASSWORD=change-me
