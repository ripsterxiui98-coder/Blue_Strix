{
  "boot-source": {
    "kernel_image_path": "/opt/bluestrix/sandbox/kernel/vmlinux",
    "boot_args": "console=ttyS0 reboot=k panic=1 pci=off",
    "initrd_path": null
  },
  "drives": [
    {
      "drive_id": "rootfs",
      "path_on_host": "/opt/bluestrix/sandbox/rootfs/rootfs.ext4",
      "is_root_device": true,
      "is_read_only": false
    }
  ],
  "network-interfaces": [],
  "machine-config": {
    "vcpu_count": 1,
    "mem_size_mib": 512,
    "smt": false
  },
  "vsock": {
    "guest_cid": 3
  }
}
