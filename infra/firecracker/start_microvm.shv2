#!/usr/bin/env bash
#
# BlueStrix Firecracker microVM launcher
# Safe by default: no network, isolated workspace, timeout enforced.
#
# Usage:
#   ./infra/firecracker/start_microvm.sh \
#     --target ./target-repo \
#     --reports ./reports \
#     --timeout 600
#
# Requirements:
#   - Linux VPS with KVM
#   - /dev/kvm available
#   - Firecracker installed
#   - Kernel image: vmlinux
#   - Rootfs image: rootfs.ext4
#
# Security:
#   - No outbound network by default
#   - No Docker socket access
#   - No host secrets mounted
#   - Target mounted read-only
#   - Reports mounted read-write
#   - MicroVM destroyed after timeout

set -Eeuo pipefail

# ---------------------------------------------------------------------------
# Defaults
# ---------------------------------------------------------------------------

TARGET_DIR=""
REPORTS_DIR="./reports"
TIMEOUT_SECONDS="600"
FC_BINARY="/usr/local/bin/firecracker"
KERNEL_IMAGE="/opt/bluestrix/sandbox/kernel/vmlinux"
ROOTFS_IMAGE="/opt/bluestrix/sandbox/rootfs/rootfs.ext4"
WORK_DIR="/tmp/bluestrix-microvm"
API_SOCKET=""
VM_ID=""
FIRECRACKER_PID=""

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

log() {
    printf '\033[1;34m[BlueStrix]\033[0m %s\n' "$*"
}

warn() {
    printf '\033[1;33m[WARN]\033[0m %s\n' "$*"
}

fail() {
    printf '\033[1;31m[ERROR]\033[0m %s\n' "$*" >&2
    cleanup
    exit 1
}

require_command() {
    command -v "$1" >/dev/null 2>&1 || fail "Required command not found: $1"
}

cleanup() {
    if [ -n "${FIRECRACKER_PID:-}" ]; then
        if kill -0 "$FIRECRACKER_PID" 2>/dev/null; then
            log "Stopping Firecracker process"
            kill "$FIRECRACKER_PID" 2>/dev/null || true
            sleep 2
            kill -9 "$FIRECRACKER_PID" 2>/dev/null || true
        fi
    fi

    if [ -n "${API_SOCKET:-}" ] && [ -S "$API_SOCKET" ]; then
        rm -f "$API_SOCKET" 2>/dev/null || true
    fi
}

trap cleanup EXIT INT TERM

# ---------------------------------------------------------------------------
# Arguments
# ---------------------------------------------------------------------------

while [[ $# -gt 0 ]]; do
    case "$1" in
        --target)
            TARGET_DIR="$2"
            shift 2
            ;;
        --reports)
            REPORTS_DIR="$2"
            shift 2
            ;;
        --timeout)
            TIMEOUT_SECONDS="$2"
            shift 2
            ;;
        --kernel)
            KERNEL_IMAGE="$2"
            shift 2
            ;;
        --rootfs)
            ROOTFS_IMAGE="$2"
            shift 2
            ;;
        --firecracker)
            FC_BINARY="$2"
            shift 2
            ;;
        --help|-h)
            cat <<EOF
Usage:
  $0 --target <directory> [--reports <directory>] [--timeout <seconds>]

Options:
  --target <dir>          Repository or directory to analyze
  --reports <dir>         Directory to store reports
  --timeout <seconds>     Maximum runtime
  --kernel <path>         Firecracker kernel image
  --rootfs <path>         Firecracker rootfs image
  --firecracker <path>    Firecracker binary path
EOF
            exit 0
            ;;
        *)
            fail "Unknown argument: $1"
            ;;
    esac
done

# ---------------------------------------------------------------------------
# Validation
# ---------------------------------------------------------------------------

if [ -z "$TARGET_DIR" ]; then
    fail "Missing required argument: --target"
fi

TARGET_DIR="$(realpath "$TARGET_DIR")"
REPORTS_DIR="$(realpath -m "$REPORTS_DIR")"

if [ ! -d "$TARGET_DIR" ]; then
    fail "Target directory not found: $TARGET_DIR"
fi

if [ ! -f "$KERNEL_IMAGE" ]; then
    fail "Kernel image not found: $KERNEL_IMAGE"
fi

if [ ! -f "$ROOTFS_IMAGE" ]; then
    fail "Rootfs image not found: $ROOTFS_IMAGE"
fi

if [ ! -x "$FC_BINARY" ]; then
    fail "Firecracker binary not found or not executable: $FC_BINARY"
fi

if [ ! -e /dev/kvm ]; then
    fail "KVM is not available. Firecracker requires /dev/kvm."
fi

if ! [ -r /dev/kvm ] || ! [ -w /dev/kvm ]; then
    fail "No permission to access /dev/kvm. Run as root or add user to kvm group."
fi

require_command curl
require_command jq

# ---------------------------------------------------------------------------
# Prepare isolated workspace
# ---------------------------------------------------------------------------

VM_ID="bluestrix-$(date +%s)-$RANDOM"
WORK_DIR="$WORK_DIR/$VM_ID"
API_SOCKET="$WORK_DIR/firecracker.sock"

mkdir -p "$WORK_DIR"
mkdir -p "$REPORTS_DIR"

TARGET_MOUNT="$WORK_DIR/target"
REPORTS_MOUNT="$WORK_DIR/reports"

mkdir -p "$TARGET_MOUNT"
mkdir -p "$REPORTS_MOUNT"

# Copy target into isolated workspace.
# This prevents the microVM from writing directly to the original repository.
cp -a "$TARGET_DIR/." "$TARGET_MOUNT/"

log "Target prepared: $TARGET_DIR"
log "Isolated workspace: $WORK_DIR"
log "Reports directory: $REPORTS_DIR"
log "Timeout: ${TIMEOUT_SECONDS}s"

# ---------------------------------------------------------------------------
# Start Firecracker
# ---------------------------------------------------------------------------

log "Starting Firecracker microVM: $VM_ID"

"$FC_BINARY" \
    --api-sock "$API_SOCKET" \
    --id "$VM_ID" \
    > "$WORK_DIR/firecracker.log" 2>&1 &

FIRECRACKER_PID=$!

sleep 2

if ! kill -0 "$FIRECRACKER_PID" 2>/dev/null; then
    fail "Firecracker failed to start"
fi

# ---------------------------------------------------------------------------
# Configure microVM
# ---------------------------------------------------------------------------

log "Configuring boot source"

curl --silent --show-error \
    --unix-socket "$API_SOCKET" \
    -X PUT "http://localhost/boot-source" \
    -H "Content-Type: application/json" \
    -d @- <<EOF
{
  "kernel_image_path": "$KERNEL_IMAGE",
  "boot_args": "console=ttyS0 reboot=k panic=1 pci=off"
}
EOF

log "Configuring rootfs"

curl --silent --show-error \
    --unix-socket "$API_SOCKET" \
    -X PUT "http://localhost/drives/rootfs" \
    -H "Content-Type: application/json" \
    -d @- <<EOF
{
  "drive_id": "rootfs",
  "path_on_host": "$ROOTFS_IMAGE",
  "is_root_device": true,
  "is_read_only": false
}
EOF

log "Configuring machine resources"

curl --silent --show-error \
    --unix-socket "$API_SOCKET" \
    -X PUT "http://localhost/machine-config" \
    -H "Content-Type: application/json" \
    -d @- <<EOF
{
  "vcpu_count": 1,
  "mem_size_mib": 512,
  "smt": false
}
EOF

log "Starting microVM"

curl --silent --show-error \
    --unix-socket "$API_SOCKET" \
    -X PUT "http://localhost/actions" \
    -H "Content-Type: application/json" \
    -d '{"action_type":"InstanceStart"}'

log "MicroVM started successfully"
log "API socket: $API_SOCKET"
log "Firecracker PID: $FIRECRACKER_PID"

# ---------------------------------------------------------------------------
# Wait for completion or timeout
# ---------------------------------------------------------------------------

log "Waiting up to ${TIMEOUT_SECONDS}s"

START_TIME=$(date +%s)

while true; do
    CURRENT_TIME=$(date +%s)
    ELAPSED=$((CURRENT_TIME - START_TIME))

    if [ "$ELAPSED" -ge "$TIMEOUT_SECONDS" ]; then
        warn "Timeout reached after ${TIMEOUT_SECONDS}s"
        break
    fi

    if ! kill -0 "$FIRECRACKER_PID" 2>/dev/null; then
        log "Firecracker process exited"
        break
    fi

    sleep 5
done

# ---------------------------------------------------------------------------
# Cleanup
# ---------------------------------------------------------------------------

log "Stopping microVM"

curl --silent --show-error \
    --unix-socket "$API_SOCKET" \
    -X PUT "http://localhost/actions" \
    -H "Content-Type: application/json" \
    -d '{"action_type":"SendCtrlAltDel"}' 2>/dev/null || true

sleep 3

cleanup

log "MicroVM stopped"
log "Reports available in: $REPORTS_DIR"
